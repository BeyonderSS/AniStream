        <item name="android:windowBackground">@color/reelm_dusk</item>
        <item name="android:colorAccent">@color/reelm_projector</item>
    </style>
    <color name="reelm_dusk">#FF15171F</color>
    <color name="reelm_projector">#FFF2B45A</color>
</resources>
